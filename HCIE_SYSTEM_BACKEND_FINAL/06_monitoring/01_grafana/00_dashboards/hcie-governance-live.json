{
  "uid": "hcie-governance-live",
  "title": "HCIE — Governance & Learning (live, Postgres)",
  "tags": ["hcie", "governance", "reviewer"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30d", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Governed interactions (total)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "hcie-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "blue" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "format": "table", "rawSql": "SELECT count(*) AS value FROM experiment_trajectories;" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Distinct learners",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "hcie-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "format": "table", "rawSql": "SELECT count(DISTINCT user_id) AS value FROM experiment_trajectories;" } ]
    },
    {
      "id": 3, "type": "stat", "title": "Concepts covered",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "hcie-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "format": "table", "rawSql": "SELECT count(DISTINCT concept) AS value FROM experiment_trajectories;" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Correct rate",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "hcie-pg" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 0.5 } ] } } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" },
      "targets": [ { "refId": "A", "format": "table", "rawSql": "SELECT avg(CASE WHEN correctness THEN 1.0 ELSE 0.0 END) AS value FROM experiment_trajectories WHERE correctness IS NOT NULL;" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Governed interactions / day (live ITS loop → Kafka → governance → Postgres)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "hcie-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 50, "showPoints": "never" } } },
      "targets": [ { "refId": "A", "format": "time_series", "rawSql": "SELECT $__timeGroup(timestamp,'1d') AS time, count(*) AS interactions FROM experiment_trajectories WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1;" } ]
    },
    {
      "id": 6, "type": "timeseries", "title": "JT governance signals — mean contribution / day (ΔM · transfer · ZPD)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "hcie-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "showPoints": "never" } } },
      "targets": [ { "refId": "A", "format": "time_series", "rawSql": "SELECT $__timeGroup(timestamp,'1d') AS time, avg(jt_delta_m_contribution) AS \"delta_M\", avg(jt_transfer_contribution) AS \"transfer\", avg(zpd_score) AS \"ZPD\" FROM experiment_trajectories WHERE $__timeFilter(timestamp) GROUP BY 1 ORDER BY 1;" } ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Mean mastery (Kalman) / day",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "postgres", "uid": "hcie-pg" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1, "custom": { "drawStyle": "line", "fillOpacity": 15, "showPoints": "never" } } },
      "targets": [ { "refId": "A", "format": "time_series", "rawSql": "SELECT $__timeGroup(timestamp,'1d') AS time, avg(kalman_mastery_after) AS mastery FROM experiment_trajectories WHERE $__timeFilter(timestamp) AND kalman_mastery_after IS NOT NULL GROUP BY 1 ORDER BY 1;" } ]
    },
    {
      "id": 8, "type": "table", "title": "Top concepts by governed interactions",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "postgres", "uid": "hcie-pg" },
      "options": { "showHeader": true },
      "targets": [ { "refId": "A", "format": "table", "rawSql": "SELECT concept, count(*) AS interactions, round(avg(CASE WHEN correctness THEN 1.0 ELSE 0.0 END)::numeric,2) AS correct_rate, round(avg(jt_value)::numeric,3) AS avg_jt, round(avg(kalman_mastery_after)::numeric,3) AS avg_mastery FROM experiment_trajectories WHERE $__timeFilter(timestamp) GROUP BY concept ORDER BY 2 DESC LIMIT 15;" } ]
    }
  ]
}
