/**
 * Resolve a dot-notation key against the dictionary tree. Returns the value
 * as a string, or undefined when missing.
 */
export function resolveKey(tree: DictNode, key: string): string | undefined {
  const parts = key.split('.')
  let node: DictNode | undefined = tree
  for (const p of parts) {
    if (node && typeof node === 'object' && p in node) {
      node = node[p]
    } else {
      return undefined
    }
  }
  return typeof node === 'string' ? node : undefined
}
